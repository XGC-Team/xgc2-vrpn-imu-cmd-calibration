<?xml version="1.0"?>
<launch>
  <!-- estimator_config is the generated full estimator.yaml, optionally
       merged from the vehicle's base estimator YAML during analysis. -->
  <arg name="ns" default="ugv1"/>
  <arg name="estimator_config"/>
  <arg name="controller_config"
       default="$(find unicycle_ugv_controller)/config/unicycle_ugv_controller.yaml"/>
  <arg name="imu_topic" default="/imu/data"/>
  <arg name="pose_topic" default="/vrpn_client_node/pose_0/pose"/>

  <include file="$(find estimator_vrpn_px4_rotor_state)/launch/vrpn_ugv_rigid_state_estimator.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="config_file" value="$(arg estimator_config)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="pose_topic" value="$(arg pose_topic)"/>
  </include>

  <include file="$(find unicycle_ugv_controller)/launch/ugv_unicycle_nmpc_controller.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="config_file" value="$(arg controller_config)"/>
    <arg name="state_source" value="state_estimator"/>
    <arg name="state_estimate_topic" value="alg/state_estimator/state"/>
  </include>
</launch>
