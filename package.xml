<?xml version="1.0"?>
<package format="2">
  <name>vrpn_imu_cmd_calibration</name>
  <version>0.1.0</version>
  <description>
    Safe short-run cmd_vel excitation and ROS bag analysis for UGV VRPN,
    IMU, control-frame yaw, and ESKF engineering parameters.
  </description>
  <maintainer email="team@xgc2.local">XGC-Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
</package>
